# ---- Geração (escolha um) ----
# auto: Anthropic se ANTHROPIC_API_KEY existir; senão OpenAI-compatível; senão extrativo (sem LLM)
VOC_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama local (gratuito):  VOC_LLM_PROVIDER=openai  VOC_LLM_BASE_URL=http://localhost:11434/v1  VOC_LLM_MODEL=llama3.1
# VOC_LLM_BASE_URL=
# VOC_LLM_MODEL=

# ---- Recuperação ----
VOC_BACKEND=hybrid
VOC_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VOC_TOP_K=12
VOC_CANDIDATES=40

# ---- Guardrails (calibre com scripts/evaluate.py) ----
VOC_MIN_EVIDENCE=3
VOC_MIN_COVERAGE=0.6
VOC_TFIDF_MIN_SCORE=0.12
VOC_DENSE_MIN_SCORE=0.45
